# Optional comma-separated browser origins. Use * for a public API (credentials are disabled).
ALLOWED_ORIGINS=*

# Optional per-process request limit per client and route, reset every minute.
RATE_LIMIT_PER_MINUTE=120

# Optional in-memory cache TTL for AniList and episode metadata, in seconds.
CACHE_TTL_SECONDS=30

# Optional API key accepted via X-API-Key. Leave unset for open public access.
# API_KEY=replace-with-a-long-random-value
